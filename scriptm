javascript:(function(){fetch('https://portal.tintern.vic.edu.au/user/token').then(function(r){return r.text()}).then(function(t){var ta=document.createElement('textarea');ta.value=JSON.stringify(JSON.parse(t).token);ta.style.cssText='position:fixed;opacity:0';document.body.appendChild(ta);ta.focus();ta.select();document.execCommand('copy');document.body.removeChild(ta)}).catch(function(e){alert('Error:\x20'+e.message)})})();
